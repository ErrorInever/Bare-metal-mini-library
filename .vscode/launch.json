{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 F446 Debug (OpenOCD)",
            "cwd": "${workspaceFolder}",
            // CMake Tools to .elf file
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            // openocd
            "servertype": "openocd",
            // configures files for STM32F4
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            // System GDB 
            "gdbPath": "/usr/bin/gdb",
            "showDevDebugOutput": "raw"
        }
    ]
}